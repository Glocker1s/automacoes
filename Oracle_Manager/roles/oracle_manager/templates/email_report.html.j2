{% macro badge(text, kind='gray') -%}
  {%- if kind == 'ok' -%}
    <span style="display:inline-block;background-color:#e8f5e9;color:#1b5e20;font-size:12px;font-weight:bold;padding:4px 8px;border-radius:2px;white-space:nowrap;">{{ text }}</span>
  {%- elif kind == 'warn' -%}
    <span style="display:inline-block;background-color:#fff3e0;color:#9a6700;font-size:12px;font-weight:bold;padding:4px 8px;border-radius:2px;white-space:nowrap;">{{ text }}</span>
  {%- elif kind == 'fail' -%}
    <span style="display:inline-block;background-color:#ffebee;color:#b42318;font-size:12px;font-weight:bold;padding:4px 8px;border-radius:2px;white-space:nowrap;">{{ text }}</span>
  {%- elif kind == 'blue' -%}
    <span style="display:inline-block;background-color:#e8f1ff;color:#184e8a;font-size:12px;font-weight:bold;padding:4px 8px;border-radius:2px;white-space:nowrap;">{{ text }}</span>
  {%- else -%}
    <span style="display:inline-block;background-color:#eeeeee;color:#333333;font-size:12px;font-weight:bold;padding:4px 8px;border-radius:2px;white-space:nowrap;">{{ text }}</span>
  {%- endif -%}
{%- endmacro %}

{% macro code(v) -%}
  <span style="font-family:Consolas,'Courier New',monospace;font-size:12px;background-color:#f5f5f5;color:#222222;padding:2px 5px;border-radius:2px;word-break:break-all;">{{ v | default('—') }}</span>
{%- endmacro %}

{% macro th(v) -%}
  <th bgcolor="#f4f6f8" style="background-color:#f4f6f8;color:#111111;font-family:Arial,sans-serif;font-size:13px;font-weight:bold;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">{{ v }}</th>
{%- endmacro %}

{% macro td_open() -%}
  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">
{%- endmacro %}

{% macro card(label, value, help='', kind='gray') -%}
  {% if kind == 'ok' %}
    {% set border = '#b7dfc2' %}
    {% set bg = '#f1f8f4' %}
    {% set color = '#1b5e20' %}
  {% elif kind == 'fail' %}
    {% set border = '#f0b4b4' %}
    {% set bg = '#fff5f5' %}
    {% set color = '#b42318' %}
  {% elif kind == 'warn' %}
    {% set border = '#f0d49a' %}
    {% set bg = '#fffaf0' %}
    {% set color = '#9a6700' %}
  {% else %}
    {% set border = '#d9d9d9' %}
    {% set bg = '#ffffff' %}
    {% set color = '#111111' %}
  {% endif %}
  <td valign="top" style="width:20%;background-color:{{ bg }};border:1px solid {{ border }};padding:10px;font-family:Arial,sans-serif;color:#111111;">
    <div style="font-size:12px;color:#666666;line-height:15px;">{{ label }}</div>
    <div style="font-size:22px;font-weight:bold;color:{{ color }};margin-top:3px;line-height:26px;">{{ value }}</div>
    {% if help | string | length > 0 %}
    <div style="font-size:11px;color:#777777;margin-top:3px;line-height:14px;">{{ help }}</div>
    {% endif %}
  </td>
{%- endmacro %}

{% set job_id = orm_report_job_id | default(tower_job_id | default(awx_job_id | default('local'))) %}
{% set template_name = orm_report_job_template | default(tower_job_template_name | default(awx_job_template_name | default('Oracle Manager'))) %}
{% set executor = tower_user_name | default(awx_user_name | default(ansible_user_id | default('N/A'))) %}
{% set action = orm_action_normalized | default(orm_action | default('-')) %}
{% set profile = orm_profile_key_normalized | default(orm_profile_key | default('-')) %}
{% set source_env = orm_source_env_effective | default(orm_source_env | default('-')) %}
{% set target_envs = orm_target_envs_effective | default([]) %}
{% set reason = orm_execution_reason | default(motivo | default('-')) %}
{% set rows = orm_report_rows | default([]) %}
{% set attachments = orm_report_attachments | default(send_mail_attachments | default([])) %}
{% set job_url = ansible_url | default('') ~ '/#/jobs/playbook/' ~ job_id ~ '/output' %}

{% set totals = namespace(ok=0, warn=0, fail=0, not_run=0, backup=0, restore=0) %}
{% for row in rows %}
  {% if row.status == 'SUCESSO' %}
    {% set totals.ok = totals.ok + 1 %}
  {% elif row.status == 'SUCESSO COM AVISO' %}
    {% set totals.warn = totals.warn + 1 %}
  {% elif row.status == 'FALHA' %}
    {% set totals.fail = totals.fail + 1 %}
  {% elif row.status == 'NÃO EXECUTADO' %}
    {% set totals.not_run = totals.not_run + 1 %}
  {% endif %}

  {% if row.action == 'backup' %}
    {% set totals.backup = totals.backup + 1 %}
  {% elif row.action == 'restore' %}
    {% set totals.restore = totals.restore + 1 %}
  {% endif %}
{% endfor %}

{% if orm_overall_status == 'SUCESSO' %}
  {% set banner_color = '#1f4d2b' %}
  {% set status_kind = 'ok' %}
{% elif orm_overall_status == 'SUCESSO COM AVISO' %}
  {% set banner_color = '#8a5a00' %}
  {% set status_kind = 'warn' %}
{% else %}
  {% set banner_color = '#7f1d1d' %}
  {% set status_kind = 'fail' %}
{% endif %}

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;font-family:Arial,sans-serif;font-size:13px;color:#111111;">
  <tr>
    <td align="left" style="padding:8px 8px 12px 8px;">
      <table role="presentation" width="1080" cellspacing="0" cellpadding="0" border="0" style="width:1080px;border-collapse:collapse;mso-table-lspace:0pt;mso-table-rspace:0pt;font-family:Arial,sans-serif;font-size:13px;color:#111111;">

        <tr>
          <td bgcolor="{{ banner_color }}" style="background-color:{{ banner_color }};padding:15px 16px;font-family:Arial,sans-serif;color:#ffffff;">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;">
              <tr>
                <td align="left" valign="top" style="font-family:Arial,sans-serif;color:#ffffff;">
                  <div style="font-size:19px;font-weight:bold;color:#ffffff;margin:0;padding:0;">
                    {{ orm_report_title | default('Oracle Manager') }}
                  </div>
                  <div style="font-size:13px;color:#f2f2f2;margin-top:5px;line-height:18px;">
                    Job: <b>{{ job_id }}</b>
                    &nbsp;|&nbsp; Template: <b>{{ template_name }}</b>
                    &nbsp;|&nbsp; Executor: <b>{{ executor }}</b>
                  </div>
                </td>
                <td align="right" valign="top" style="font-family:Arial,sans-serif;color:#ffffff;">
                  {{ badge(orm_overall_status | default('N/A'), status_kind) }}
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="border-left:1px solid #d9d9d9;border-right:1px solid #d9d9d9;padding:12px 16px;font-family:Arial,sans-serif;font-size:13px;color:#111111;">
            <b>Ação:</b> {{ badge(action | upper, 'blue') }}
            &nbsp;&nbsp;
            <b>Profile:</b> {{ code(profile) }}
            &nbsp;&nbsp;
            <b>Origem:</b> {{ code(source_env) }}
            &nbsp;&nbsp;
            <b>Destino(s):</b>
            {% if target_envs | length > 0 %}
              {{ code(target_envs | join(', ')) }}
            {% else %}
              {{ code('—') }}
            {% endif %}
            <br/>
            <div style="margin-top:7px;">
              <b>Motivo:</b> {{ reason if reason | string | length > 0 else '—' }}
            </div>
          </td>
        </tr>

        <tr>
          <td style="padding-top:14px;">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;">
              <tr>
                {{ card('Hosts com sucesso', totals.ok, 'Execuções concluídas sem erro', 'ok') }}
                <td width="1%" style="font-size:1px;">&nbsp;</td>
                {{ card('Hosts com aviso', totals.warn, 'Execuções concluídas com observação', 'warn') }}
                <td width="1%" style="font-size:1px;">&nbsp;</td>
                {{ card('Hosts com falha', totals.fail + totals.not_run, 'Execuções que exigem análise', 'fail') }}
                <td width="1%" style="font-size:1px;">&nbsp;</td>
                {{ card('Backups', totals.backup, 'Rotinas de backup executadas', 'gray') }}
                <td width="1%" style="font-size:1px;">&nbsp;</td>
                {{ card('Restores', totals.restore, 'Rotinas de restore executadas', 'gray') }}
              </tr>
            </table>
          </td>
        </tr>

        {% if orm_controller_failed | default(false) | bool %}
        <tr>
          <td style="padding-top:16px;">
            <div style="font-family:Arial,sans-serif;font-size:15px;font-weight:bold;color:#b42318;margin-bottom:7px;">Falha no planejamento</div>
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;">
              <tr>{{ th('Campo') }}{{ th('Valor') }}</tr>
              <tr>{{ td_open() }}Task</td>{{ td_open() }}{{ code(orm_controller_failed_task | default('desconhecida')) }}</td></tr>
              <tr>{{ td_open() }}Mensagem</td>{{ td_open() }}<pre style="white-space:pre-wrap;font-family:Consolas,'Courier New',monospace;font-size:12px;margin:0;">{{ orm_controller_error_msg | default('') }}</pre></td></tr>
            </table>
          </td>
        </tr>
        {% endif %}

        {% if orm_sync_backup_blocked | default(false) | bool %}
        <tr>
          <td style="padding-top:16px;">
            <div style="background-color:#fff5f5;border:1px solid #f0b4b4;padding:10px;font-family:Arial,sans-serif;font-size:13px;color:#b42318;">
              <b>Restore do sync bloqueado.</b>
              <div style="margin-top:5px;color:#222222;">{{ orm_sync_restore_skip_reason | default('O backup da origem não terminou com sucesso.') }}</div>
            </div>
          </td>
        </tr>
        {% endif %}

        {% if rows | selectattr('status', 'in', ['FALHA', 'SUCESSO COM AVISO', 'NÃO EXECUTADO']) | list | length > 0 %}
        <tr>
          <td style="padding-top:16px;">
            <div style="font-family:Arial,sans-serif;font-size:15px;font-weight:bold;color:#111111;margin-bottom:7px;">Detalhes de falhas e avisos</div>
            {% for row in rows %}
              {% if row.status in ['FALHA', 'SUCESSO COM AVISO', 'NÃO EXECUTADO'] %}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;margin-bottom:10px;">
                <tr>
                  <td bgcolor="{{ '#fff5f5' if row.status in ['FALHA', 'NÃO EXECUTADO'] else '#fffaf0' }}" style="background-color:{{ '#fff5f5' if row.status in ['FALHA', 'NÃO EXECUTADO'] else '#fffaf0' }};border:1px solid {{ '#f0b4b4' if row.status in ['FALHA', 'NÃO EXECUTADO'] else '#f0d49a' }};padding:10px;font-family:Arial,sans-serif;font-size:13px;color:#111111;">
                    <div style="font-size:14px;font-weight:bold;color:{{ '#b42318' if row.status in ['FALHA', 'NÃO EXECUTADO'] else '#9a6700' }};margin-bottom:5px;">
                      {{ row.host }} / {{ row.env }} / {{ row.action | upper }} - {{ row.status }}
                    </div>
                    {% if row.failed_task | default('') | length > 0 %}<b>Task:</b> {{ code(row.failed_task) }}<br/>{% endif %}
                    {% if row.database_state | default('') | length > 0 %}<b>Estado do restore:</b> {{ code(row.database_state) }}<br/>{% endif %}
                    {% if row.password_warning | default('') | length > 0 %}<div style="margin-top:6px;"><b>Senha:</b> {{ row.password_warning }}</div>{% endif %}
                    {% if row.grants_warning | default('') | length > 0 %}<div style="margin-top:6px;"><b>Grants:</b> {{ row.grants_warning }}</div>{% endif %}
                    {% if row.invalid_objects_warning | default('') | length > 0 %}<div style="margin-top:6px;"><b>Objetos INVALID:</b> {{ row.invalid_objects_warning }}</div>{% endif %}
                    {% if row.error | default('') | length > 0 %}
                    <pre style="white-space:pre-wrap;font-family:Consolas,'Courier New',monospace;font-size:12px;background-color:#ffffff;border:1px solid #ead2d2;padding:8px;margin-top:8px;color:#222222;">{{ row.error }}</pre>
                    {% endif %}
                    {% if row.error_excerpt | default('') | length > 0 %}
                    <div style="font-weight:bold;margin-top:8px;">Trecho dos logs:</div>
                    <pre style="white-space:pre-wrap;font-family:Consolas,'Courier New',monospace;font-size:12px;background-color:#ffffff;border:1px solid #ead2d2;padding:8px;margin-top:5px;color:#222222;">{{ row.error_excerpt }}</pre>
                    {% endif %}
                  </td>
                </tr>
              </table>
              {% endif %}
            {% endfor %}
          </td>
        </tr>
        {% endif %}

        <tr>
          <td style="padding-top:16px;">
            <div style="font-family:Arial,sans-serif;font-size:15px;font-weight:bold;color:#111111;margin-bottom:7px;">Resumo por host</div>
            {% if rows | length == 0 %}
              <div style="font-family:Arial,sans-serif;font-size:13px;color:#666666;">Nenhum host foi processado nesta execução.</div>
            {% else %}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;">
                <tr>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">Ambiente</th>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">Host</th>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">Ação</th>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">SID</th>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">PDB</th>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">Schema(s)</th>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">Status</th>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">Início</th>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">Fim</th>
                  <th style="font-family:Arial,sans-serif;font-size:12px;font-weight:bold;color:#222222;background-color:#f1f2f3;text-align:left;border:1px solid #d9d9d9;padding:8px;vertical-align:top;">Duração</th>
                </tr>
                {% for row in rows %}
                <tr>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;white-space:nowrap;">{{ row.env | default('—') }}</td>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;white-space:nowrap;"><b>{{ row.host | default('—') }}</b></td>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;white-space:nowrap;">{{ badge((row.action | default('—')) | upper, 'blue') }}</td>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;white-space:nowrap;">{{ code(row.sid if row.sid else '—') }}</td>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;white-space:nowrap;">{{ code(row.pdb if row.pdb else '—') }}</td>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;">
                    {% if row.schemas is sequence and row.schemas is not string %}{{ row.schemas | join(', ') }}{% else %}{{ row.schemas | default('—') }}{% endif %}
                  </td>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;white-space:nowrap;">
                    {% if row.status == 'SUCESSO' %}{{ badge(row.status, 'ok') }}{% elif row.status == 'SUCESSO COM AVISO' %}{{ badge(row.status, 'warn') }}{% elif row.status in ['FALHA', 'NÃO EXECUTADO'] %}{{ badge(row.status, 'fail') }}{% else %}{{ badge(row.status | default('N/A'), 'gray') }}{% endif %}
                  </td>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;white-space:nowrap;">{% if row.started_at | default('') | length > 0 %}<b>{{ row.started_at.split(' ')[-1] }}</b>{% else %}—{% endif %}</td>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;white-space:nowrap;">{% if row.finished_at | default('') | length > 0 %}<b>{{ row.finished_at.split(' ')[-1] }}</b>{% else %}—{% endif %}</td>
                  <td style="font-family:Arial,sans-serif;font-size:13px;color:#111111;border:1px solid #d9d9d9;padding:8px;vertical-align:middle;white-space:nowrap;">{% if row.duration | default('') | length > 0 %}<b>{{ row.duration }}</b>{% else %}—{% endif %}</td>
                </tr>
                {% endfor %}
              </table>
            {% endif %}
          </td>
        </tr>

        {% if rows | selectattr('action', 'equalto', 'restore') | list | length > 0 %}
        <tr>
          <td style="padding-top:16px;">
            <div style="font-family:Arial,sans-serif;font-size:15px;font-weight:bold;color:#111111;margin-bottom:7px;">Detalhes do restore</div>
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;">
              <tr>{{ th('Host') }}{{ th('Dump') }}{{ th('Origem do dump') }}{{ th('Sessões') }}{{ th('INVALID') }}{{ th('Estado') }}</tr>
              {% for row in rows %}
                {% if row.action == 'restore' %}
                <tr>
                  {{ td_open() }}<b>{{ row.host }}</b></td>
                  {{ td_open() }}{{ code(row.dump if row.dump else '—') }}{% if row.dump_size_bytes | default(0) | int > 0 %}<div style="font-size:11px;color:#777777;margin-top:4px;">{{ '%.2f MB' | format((row.dump_size_bytes | int) / 1048576) }}</div>{% endif %}</td>
                  {{ td_open() }}{{ code(row.dump_source if row.dump_source else '—') }}</td>
                  {{ td_open() }}{{ row.sessions_before if row.sessions_before != '' else '—' }} antes / {{ row.sessions_after if row.sessions_after != '' else '—' }} depois</td>
                  {{ td_open() }}{{ row.invalid_objects if row.invalid_objects != '' else '—' }}</td>
                  {{ td_open() }}{{ code(row.database_state if row.database_state else '—') }}</td>
                </tr>
                {% endif %}
              {% endfor %}
            </table>
          </td>
        </tr>
        {% endif %}

        <tr>
          <td style="padding-top:16px;">
            <div style="font-family:Arial,sans-serif;font-size:15px;font-weight:bold;color:#111111;margin-bottom:7px;">Anexos e artefatos</div>
            {% if attachments | length > 0 %}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width:100%;border-collapse:collapse;">
                <tr>{{ th('Arquivo') }}</tr>
                {% for item in attachments %}<tr>{{ td_open() }}{{ code(item) }}</td></tr>{% endfor %}
              </table>
            {% else %}
              <div style="background-color:#fffaf0;border:1px solid #f0d49a;padding:10px;font-family:Arial,sans-serif;font-size:13px;color:#9a6700;">Nenhum anexo foi publicado para este relatório.</div>
            {% endif %}

            {% if orm_report_artifact_warning | default(false) | bool %}
              <div style="background-color:#fffaf0;border:1px solid #f0d49a;padding:10px;margin-top:8px;font-family:Arial,sans-serif;font-size:13px;color:#9a6700;">
                <b>Atenção:</b> nem todos os artefatos esperados puderam ser coletados.
                {% if orm_missing_report_artifacts | default([]) | length > 0 %}
                <ul style="margin:7px 0 0 18px;padding:0;">
                  {% for item in orm_missing_report_artifacts %}<li>{{ item.host }}: {{ item.path }}</li>{% endfor %}
                </ul>
                {% endif %}
              </div>
            {% endif %}

            {% if orm_cifs_report_upload_failed | default(false) | bool %}
              <div style="background-color:#fffaf0;border:1px solid #f0d49a;padding:10px;margin-top:8px;font-family:Arial,sans-serif;font-size:13px;color:#9a6700;">
                <b>Atenção:</b> houve falha ao publicar anexos no CIFS.
                <pre style="white-space:pre-wrap;font-family:Consolas,'Courier New',monospace;font-size:12px;background-color:#ffffff;border:1px solid #ead2d2;padding:8px;margin-top:8px;color:#222222;">{{ orm_cifs_report_upload_error | default('Erro não informado.') }}</pre>
              </div>
            {% endif %}

            {% if orm_restore_cleanup_failed | default(false) | bool %}
              <div style="background-color:#fffaf0;border:1px solid #f0d49a;padding:10px;margin-top:8px;font-family:Arial,sans-serif;font-size:13px;color:#9a6700;">
                <b>Atenção:</b> houve falha ao remover artefatos locais de restore dos destinos.
                <pre style="white-space:pre-wrap;font-family:Consolas,'Courier New',monospace;font-size:12px;background-color:#ffffff;border:1px solid #ead2d2;padding:8px;margin-top:8px;color:#222222;">{{ orm_restore_cleanup_error | default('Erro não informado.') }}</pre>
              </div>
            {% endif %}

            {% if orm_cifs_cleanup_failed | default(false) | bool %}
              <div style="background-color:#fffaf0;border:1px solid #f0d49a;padding:10px;margin-top:8px;font-family:Arial,sans-serif;font-size:13px;color:#9a6700;">
                <b>Atenção:</b> houve falha ao remover o dump consumido, log e/ou manifesto latest do CIFS.
                <pre style="white-space:pre-wrap;font-family:Consolas,'Courier New',monospace;font-size:12px;background-color:#ffffff;border:1px solid #ead2d2;padding:8px;margin-top:8px;color:#222222;">{{ orm_cifs_cleanup_error | default('Erro não informado.') }}</pre>
              </div>
            {% endif %}

            {% if orm_local_cleanup_failed | default(false) | bool %}
              <div style="background-color:#fffaf0;border:1px solid #f0d49a;padding:10px;margin-top:8px;font-family:Arial,sans-serif;font-size:13px;color:#9a6700;">
                <b>Atenção:</b> houve falha ao remover o backup local criado na origem durante o sync.
                <pre style="white-space:pre-wrap;font-family:Consolas,'Courier New',monospace;font-size:12px;background-color:#ffffff;border:1px solid #ead2d2;padding:8px;margin-top:8px;color:#222222;">{{ orm_local_cleanup_error | default('Erro não informado.') }}</pre>
              </div>
            {% endif %}
          </td>
        </tr>

        <tr>
          <td style="padding-top:14px;font-family:Arial,sans-serif;font-size:12px;color:#666666;line-height:18px;">
            Output do job:
            {% if ansible_url | default('') | length > 0 %}<a href="{{ job_url }}" style="color:#184e8a;text-decoration:none;">{{ job_id }}</a>{% else %}{{ job_id }}{% endif %}
            <br/>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>